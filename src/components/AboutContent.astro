<script define:vars={{ showMore: t('common.showMore'), showLess: t('common.showLess') }}>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('[data-toggle]');

    toggleButtons.forEach(button => {
      button.addEventListener('click', () => {
        const jobContent = button.closest('.job-content');
        const hiddenList = jobContent?.querySelector('[data-expandable]');

        if (hiddenList) {
          const isExpanded = hiddenList.classList.contains('expanded');

          if (isExpanded) {
            hiddenList.classList.remove('expanded');
            button.classList.remove('expanded');
            button.textContent = showMore;
          } else {
            hiddenList.classList.add('expanded');
            button.classList.add('expanded');
            button.textContent = showLess;
          }
        }
      });
    });
  });
</script>

<style>
  .page-header {
    margin-top: 3rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
  }

  .page-header h1 {
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .summary {
    margin-bottom: 5rem;
  }

  .summary-content {
    padding: 2.5rem 0;
    background: transparent;
    border-radius: 0;
    border-left: 2px solid var(--color-accent);
    padding-left: 2rem;
  }

  .summary p {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 1.25rem;
    color: var(--color-text-light);
  }

  .summary p:last-child {
    margin-bottom: 0;
  }

  .summary .lead {
    font-size: 1.2rem;
    font-weight: 500;
  }

  .summary strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .section-number {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-text-lighter);
    line-height: 1;
    opacity: 0.4;
    transition: all 0.3s var(--ease-out-expo);
  }

  .section-header:hover .section-number {
    opacity: 0.8;
    transform: translateX(-4px);
  }

  .section-header h2 {
    margin: 0;
  }

  .experience {
    margin-bottom: 5rem;
  }

  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
  }

  .job {
    position: relative;
    margin-bottom: 3rem;
    display: flex;
    gap: 2rem;
  }

  .job:last-child {
    margin-bottom: 0;
  }

  .job-marker {
    position: absolute;
    left: -2rem;
    top: 0;
  }

  .job-dot {
    width: 16px;
    height: 16px;
    background: white;
    border: 3px solid var(--color-accent);
    border-radius: 50%;
    position: relative;
    left: -7px;
  }

  .job-content {
    flex: 1;
    padding: 2rem 0;
    background: transparent;
    border-radius: 0;
    border: none;
    border-bottom: 2px solid var(--color-border);
    box-shadow: none;
    transition: all 0.4s var(--ease-out-expo);
    position: relative;
  }

  .job-content::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-secondary));
    transition: width 0.5s var(--ease-out-expo);
  }

  .job-content:hover {
    transform: translateX(8px) rotate(0.3deg);
  }

  .job-content:hover::after {
    width: 100%;
  }

  .job-header {
    margin-bottom: 1rem;
  }

  .job-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .job-header h3 {
    font-size: 1.4rem;
    margin: 0;
    color: var(--color-text);
  }

  .period {
    color: var(--color-text-lighter);
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .company-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .company-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .company-logo {
    height: 28px;
    width: auto;
    display: block;
  }

  .company {
    font-weight: 600;
    color: var(--color-text);
    font-size: 1.05rem;
  }

  .job-badge {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: transparent;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 0;
    border: 1px solid var(--color-accent);
  }

  .job-subtitle {
    font-style: italic;
    color: var(--color-text-light);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .job-list {
    list-style: none;
    margin-left: 0;
    margin-bottom: 0;
  }

  .job-list-hidden {
    display: none;
    margin-top: 0;
  }

  .job-list-hidden.expanded {
    display: block;
  }

  .expand-btn {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background: transparent;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s var(--ease-out-expo);
    font-family: inherit;
