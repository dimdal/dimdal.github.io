---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutContent from '../components/AboutContent.astro';
import { defaultLang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

const lang = defaultLang;
const t = useTranslations(lang);
---

<BaseLayout
  title={`Om Marius Ørvik - Product Manager Norge | AI & Produktledelse`}
  description="Produktleder og VP Product & Engineering med ekspertise i B2B SaaS, AI-innovasjon og produktledet vekst. Basert i Oslo."
>
  <AboutContent lang={lang} />
</BaseLayout>
