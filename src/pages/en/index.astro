---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout title="Marius Ørvik - VP Product & Engineering">
  <div class="hero">
    <div class="hero-badge" set:html={t('home.badge')}></div>
    <h1>Marius Ørvik</h1>
    <p class="tagline" set:html={t('home.tagline')}></p>
    <p class="intro" set:html={t('home.intro')}></p>
  </div>

  <section class="impact">
    <div class="section-header">
      <span class="section-number">01</span>
      <h2 set:html={t('home.impact.title')}></h2>
    </div>

    <div class="impact-grid">
      <div class="impact-card" style="animation-delay: 0.15s">
        <div class="card-icon">🎯</div>
        <h3 set:html={t('home.impact.executive.title')}></h3>
        <ul>
          <li set:html={t('home.impact.executive.1')}></li>
          <li set:html={t('home.impact.executive.2')}></li>
          <li set:html={t('home.impact.executive.3')}></li>
        </ul>
      </div>

      <div class="impact-card" style="animation-delay: 0.3s">
        <div class="card-icon">🤖</div>
        <h3 set:html={t('home.impact.ai.title')}></h3>
        <ul>
          <li set:html={t('home.impact.ai.1')}></li>
          <li set:html={t('home.impact.ai.2')}></li>
          <li set:html={t('home.impact.ai.3')}></li>
        </ul>
      </div>

      <div class="impact-card" style="animation-delay: 0.45s">
        <div class="card-icon">👥</div>
        <h3 set:html={t('home.impact.team.title')}></h3>
        <ul>
          <li set:html={t('home.impact.team.1')}></li>
          <li set:html={t('home.impact.team.2')}></li>
          <li set:html={t('home.impact.team.3')}></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="philosophy">
    <div class="section-header">
      <span class="section-number">02</span>
      <h2 set:html={t('home.philosophy.title')}></h2>
    </div>

    <div class="philosophy-content">
      <p class="philosophy-text" set:html={t('home.philosophy.text')}></p>

      <div class="principles">
        <div class="principle">
          <strong set:html={t('home.philosophy.plg')}></strong>
          <span set:html={t('home.philosophy.plg.desc')}></span>
        </div>
        <div class="principle">
          <strong set:html={t('home.philosophy.evidence')}></strong>
          <span set:html={t('home.philosophy.evidence.desc')}></span>
        </div>
        <div class="principle">
          <strong set:html={t('home.philosophy.team')}></strong>
          <span set:html={t('home.philosophy.team.desc')}></span>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta-content">
      <h3 set:html={t('home.cta.title')}></h3>
      <p set:html={t('home.cta.text')}></p>
      <div class="cta-buttons">
        <a href="/en/about" class="button">
          <span set:html={t('home.cta.experience')}></span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/en/contact" class="button-secondary">
          <span set:html={t('home.cta.contact')}></span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <style>
    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(40px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.95);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .hero {
      padding: 4rem 0;
      margin-bottom: 1rem;
      position: relative;
      max-width: 85%;
    }

    @media (max-width: 768px) {
      .hero {
        max-width: 100%;
      }
    }

    .hero-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      background: var(--color-accent);
      color: white;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-radius: 0;
      margin-bottom: 1.5rem;
      animation: slideInUp 0.6s var(--ease-out-expo);
    }

    .hero h1 {
      animation: slideInUp 0.6s var(--ease-out-expo) 0.1s both;
    }

    .tagline {
      font-size: clamp(1.1rem, 2vw, 1.4rem);
      color: var(--color-text-light);
      margin-bottom: 1.5rem;
      font-weight: 500;
      animation: slideInUp 0.6s var(--ease-out-expo) 0.2s both;
    }

    .intro {
      font-size: 1.15rem;
      line-height: 1.8;
      max-width: 800px;
      color: var(--color-text-light);
      margin-bottom: 2.5rem;
      animation: slideInUp 0.6s var(--ease-out-expo) 0.3s both;
    }

    .intro strong {
      color: var(--color-text);
      font-weight: 600;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .section-number {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 3rem;
      font-weight: 800;
      color: var(--color-text-lighter);
      line-height: 1;
      opacity: 0.4;
      transition: all 0.3s var(--ease-out-expo);
    }

    .section-header:hover .section-number {
      opacity: 0.8;
      transform: translateX(-4px);
    }

    .section-header h2 {
      margin: 0;
    }

    .impact {
      margin-top: 0;
      margin-bottom: 6rem;
    }

    .impact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2.5rem;
    }

    .impact-card {
      padding: 2rem 0;
      background: transparent;
      border-radius: 0;
      border: none;
      border-bottom: 2px solid var(--color-border);
      box-shadow: none;
      transition: all 0.4s var(--ease-out-expo);
      animation: scaleIn 0.6s var(--ease-out-expo) both;
      position: relative;
    }

    .impact-card::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--color-accent), var(--color-accent-secondary));
      transition: width 0.5s var(--ease-out-expo);
    }

    .impact-card:hover {
      transform: translateX(12px) rotate(0.5deg);
    }

    .impact-card:hover::after {
      width: 100%;
    }

    .card-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      display: inline-block;
      transition: all 0.4s var(--ease-spring);
    }

    .impact-card:hover .card-icon {
      transform: scale(1.15) rotate(-5deg);
    }

    .impact-card h3 {
      margin-bottom: 1rem;
      font-size: 1.35rem;
    }

    .impact-card ul {
      margin-left: 0;
      list-style: none;
    }

    .impact-card li {
      padding-left: 1.5rem;
      position: relative;
      margin-bottom: 0.75rem;
      color: var(--color-text-light);
      line-height: 1.6;
    }

    .impact-card li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: bold;
    }

    .impact-card strong {
      color: var(--color-text);
      font-weight: 600;
    }

    .philosophy {
      margin-bottom: 6rem;
      padding: 3rem 0;
      background: transparent;
      border-radius: 0;
      border: none;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .philosophy-text {
      font-size: 1.15rem;
      line-height: 1.8;
      margin-bottom: 2.5rem;
      max-width: 900px;
    }

    .philosophy-text strong {
      color: var(--color-text);
      font-weight: 600;
    }

    .principles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .principle {
      padding: 1.5rem 0;
      background: transparent;
      border-radius: 0;
      border-left: 2px solid var(--color-border);
      padding-left: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      transition: all 0.4s var(--ease-out-expo);
      position: relative;
    }

    .principle::before {
      content: '';
      position: absolute;
      left: -2px;
      top: 0;
      width: 2px;
      height: 0;
      background: linear-gradient(180deg, var(--color-accent), var(--color-accent-secondary));
      transition: height 0.4s var(--ease-out-expo);
    }

    .principle:hover {
      transform: translateX(8px);
      border-left-color: transparent;
    }

    .principle:hover::before {
      height: 100%;
    }

    .principle strong {
      color: var(--color-text);
      font-size: 1.05rem;
      font-weight: 600;
    }

    .principle span {
      color: var(--color-text-light);
      font-size: 0.95rem;
    }

    .cta {
      margin: 5rem 0;
      text-align: center;
    }

    .cta-content {
      padding: 4rem 0;
      background: transparent;
      border-radius: 0;
      color: var(--color-text);
      box-shadow: none;
      border-top: 1px solid var(--color-border);
    }

    .cta-content h3 {
      color: var(--color-text);
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .cta-content p {
      color: var(--color-text-light);
      font-size: 1.15rem;
      margin-bottom: 2rem;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .button, .button-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 1.75rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      transition: all 0.4s var(--ease-out-expo);
      text-decoration: none;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .button svg, .button-secondary svg {
      transition: transform 0.4s var(--ease-out-expo);
    }

    .button {
      background: var(--color-accent);
      color: white;
      border: 2px solid var(--color-accent);
    }

    .button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.5s ease;
    }

    .button:hover {
      transform: translateY(-3px);
      background: var(--color-accent-hover);
      border-color: var(--color-accent-hover);
      color: white;
      text-decoration: none;
      box-shadow: 0 8px 20px -4px rgba(232, 93, 84, 0.3);
    }

    .button:hover::before {
      left: 100%;
    }

    .button:hover svg {
      transform: translateX(4px);
    }

    .button-secondary {
      background: transparent;
      color: var(--color-text);
      border: 2px solid var(--color-border);
    }

    .button-secondary:hover {
      background: var(--color-text);
      color: var(--color-bg);
      border-color: var(--color-text);
      text-decoration: none;
      transform: translateY(-3px);
      box-shadow: 0 8px 20px -4px rgba(24, 24, 27, 0.2);
    }

    .button-secondary:hover svg {
      transform: translateX(4px);
    }

    @media (max-width: 768px) {
      .hero {
        padding: 2rem 0;
      }

      .section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .section-number {
        font-size: 2rem;
      }

      .impact-grid {
        grid-template-columns: 1fr;
      }

      .philosophy {
        padding: 2rem 1.5rem;
      }

      .principles {
        grid-template-columns: 1fr;
      }

      .cta-content {
        padding: 3rem 1.5rem;
      }

      .cta-buttons {
        flex-direction: column;
        align-items: center;
      }

      .button, .button-secondary {
        width: 100%;
        max-width: 300px;
      }
    }
  </style>
</BaseLayout>
